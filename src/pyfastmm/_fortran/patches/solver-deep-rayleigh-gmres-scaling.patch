 complex(dp) :: temp(2), tmp, hr
 complex(dp) :: temp_2(2), tmp_2, hr_2
 
+! Jacobi balancing of the linear system. In the deep-Rayleigh regime
+! (x = k*r << 1) the raw one-center system spans a dynamic range of
+! |t_n| * |h_{n+nu}(kd)| ~ x^{2n+1} * (kd)^-(n+nu+1): at Nmax=13 and
+! x ~ 0.03 its measured rcond is ~1e-60, i.e. numerically singular in
+! double precision, and any solver's answer then depends on its
+! iteration path (this broke rotational invariance and biased cross
+! sections by factors of 2-4 for touching deep-Rayleigh clusters).
+! Solving the similarity-transformed system S^-1 (I - T A) S with
+! S = diag(sqrt|t_n|) is exact in exact arithmetic and collapses the
+! dynamic range, so the GMRES answer becomes solver-path independent.
+! Only built for the Mie-sphere path (size(Tmat)==0, the only path the
+! Python extension exercises); with precomputed T-matrices S stays 1.
+complex(dp), dimension(:), allocatable :: sdiag, mxs, mxs2, bs, bs2
+complex(dp), dimension(:), allocatable :: sa_nm, sb_nm, sc_nm, sd_nm
+integer :: s_sph, s_nm, s_i
+
 N = size(b)
 
+allocate(sdiag(N), mxs(N), mxs2(N), bs(N), bs2(N))
+sdiag = dcmplx(1.0d0, 0.0d0)
+if (size(Tmat) == 0) then
+   do s_sph = 1, size(sphere)
+      s_nm = (sphere(s_sph)%Nmax+1)**2 - 1
+      allocate(sa_nm(s_nm), sb_nm(s_nm), sc_nm(s_nm), sd_nm(s_nm))
+      call mie_coeff_nm(sphere(s_sph)%Nmax, real(kk)*sphere(s_sph)%r, &
+           sqrt(sphere(s_sph)%eps_r), sa_nm, sb_nm, sc_nm, sd_nm)
+      ! the a-block carries M-type waves whose Mie coefficient is b_n,
+      ! and vice versa -- same pairing matvecI_mlfmm2/rhs2_xy use.
+      do s_i = 1, s_nm
+         sdiag(sphere(s_sph)%ind_a1 + s_i - 1) = sqrt(abs(sb_nm(s_i)))
+         sdiag(sphere(s_sph)%ind_b1 + s_i - 1) = sqrt(abs(sa_nm(s_i)))
+      end do
+      deallocate(sa_nm, sb_nm, sc_nm, sd_nm)
+   end do
+   ! an index-matched ("ghost") sphere has t_n == 0; keep S nonsingular
+   where (abs(sdiag) == 0.0d0) sdiag = dcmplx(1.0d0, 0.0d0)
+end if
+
 err_tol = tol
 max_iter = restart ! restart number
 m = maxit ! number of iterations / restarts
